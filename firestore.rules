rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    match /fee_invoices/{invoice} {
      allow read, write: if request.auth != null;
    }
    match /discounts/{discount} {
      allow read, write: if request.auth != null;
    }
    match /late_fees/{cfg} {
      allow read, write: if request.auth != null;
    }
    match /users/{user} {
      allow read, write: if request.auth != null;
    }
  }
}